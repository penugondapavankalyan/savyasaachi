# ============================================================
# Kirana Agent — environment variables
# Copy this file to .env and fill in your real values.
# Never commit .env to version control.
# ============================================================

# ---- Supabase (required) ----
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Upstash Redis (required) ----
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- Telegram (required) ----
TELEGRAM_BOT_TOKEN=

# ---- LLM ----
LLM_PROVIDER=ollama                         
OLLAMA_MODEL=gpt-oss:120b-cloud
OLLAMA_API_KEY=
OLLAMA_BASE_URL=https://ollama.com/v1
SAVYASAACHI_INVOICE_URL = <URL to redirect on Invoice>
# LLM_TEMPERATURE=0.3"""  """

# ---- Tuning (optional — defaults shown) ----
DRAFT_BILL_TTL_HOURS=4
MAX_HISTORY_MESSAGES=20

# ---- Local testing only ----
TEST_TELEGRAM_USER_ID=99999       # fake ID used by scripts/test_agent_local.py

# ---- Local development (run_local.py only) ----
LOCAL_MODE=true

TELEGRAM_TEST_CHAT_ID=<YOUR_TELEGRAM_CHAT_ID> # while testing in local if you want to see how msg looks in telegram you can use /sendtg so that it will send the last msg to the telegram bot
